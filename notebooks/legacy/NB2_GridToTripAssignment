=====================================\n","# GRID ASSIGNMENT\n","# =====================================================\n","\n","def assign_grid_ids(df, zone_column, output_column, lookup, rng):\n","\n","    result = np.empty(len(df), dtype=np.int32)\n","\n","    for zone_id, indices in df.groupby(zone_column).groups.items():\n","\n","        grids = lookup[zone_id]\n","\n","        result[indices] = rng.choice(\n","            grids,\n","            size=len(indices)\n","        )\n","\n","    df[output_column] = result"],"metadata":{"id":"8YOAnvcWm7T8"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# =====================================================\n","# PROCESS ONE MONTH\n","# =====================================================\n","\n","def process_month(month):\n","\n","    print(\"=\" * 70)\n","    print(f\"Processing {YEAR}-{month:02d}\")\n","    print(\"=\" * 70)\n","\n","    rng = np.random.default_rng(RANDOM_SEED + month)\n","\n","    trip_file = (\n","        NYC_TAXI_DIR /\n","        f\"yellow_tripdata_{YEAR}-{month:02d}.parquet\"\n","    )\n","\n","    df = pd.read_parquet(trip_file)\n","\n","    trips_loaded = len(df)\n","\n","    print(f\"Trips Loaded              : {trips_loaded:,}\")\n","\n","    keep_columns = [\n","    \"tpep_pickup_datetime\",\n","    \"tpep_dropoff_datetime\",\n","    \"PULocationID\",\n","    \"DOLocationID\",\n","    \"passenger_count\",\n","    \"trip_distance\",\n","    \"fare_amount\"\n","    ]\n","\n","    df = df[keep_columns].copy()\n","\n","    df = df.dropna(\n","        subset=[\"PULocationID\", \"DOLocationID\"]\n","    )\n","\n","    df[\"PULocationID\"] = df[\"PULocationID\"].astype(np.int16)\n","    df[\"DOLocationID\"] = df[\"DOLocationID\"].astype(np.int16)\n","\n","    # -------------------------------------------------\n","    # Remove invalid TLC zones (264, 265, etc.)\n","    # -------------------------------------------------\n","\n","    VALID_ZONE_IDS = set(zone_to_grids.keys())\n","\n","    before_filter = len(df)\n","\n","    df = (\n","    df[\n","        df[\"PULocationID\"].isin(VALID_ZONE_IDS) &\n","        df[\"DOLocationID\"].isin(VALID_ZONE_IDS)\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","    dropped = before_filter - len(df)\n","\n","    print(f\"Dropped Invalid Zones     : {dropped:,}\")\n","    print(f\"Trips After Validation    : {len(df):,}\")\n","\n","    # -------------------------------------------------\n","    # Assign Pickup Grid\n","    # -------------------------------------------------\n","\n","    assign_grid_ids(\n","        df,\n","        \"PULocationID\",\n","        \"PUGridID\",\n","        zone_to_grids,\n","        rng\n","    )\n","\n","    # -------------------------------------------------\n","    # Assign Dropoff Grid\n","    # -------------------------------------------------\n","\n","    assign_grid_ids(\n","        df,\n","        \"DOLocationID\",\n","        \"DOGridID\",\n","        zone_to_grids,\n","        rng\n","    )\n","\n","    # -------------------------------------------------\n","    # Validation\n","    # -------------------------------------------------\n","\n","    invalid_pu = (~df[\"PUGridID\"].isin(VALID_GRID_IDS)).sum()\n","    invalid_do = (~df[\"DOGridID\"].isin(VALID_GRID_IDS)).sum()\n","\n","    print(f\"Invalid PUGridIDs         : {invalid_pu}\")\n","    print(f\"Invalid DOGridIDs         : {invalid_do}\")\n","\n","    print(f\"Unique Pickup Grids       : {df['PUGridID'].nunique()}\")\n","    print(f\"Unique Dropoff Grids      : {df['DOGridID'].nunique()}\")\n","\n","    # -------------------------------------------------\n","    # Save\n","    # -------------------------------------------------\n","\n","    output_file = (\n","        OUTPUT_DIR /\n","        f\"tripdata_{YEAR}_{month:02d}.parquet\"\n","    )\n","\n","    df.to_parquet(\n","        output_file,\n","        index=False\n","    )\n","\n","    print(f\"Saved                     : 